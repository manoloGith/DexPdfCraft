+# DexPdfCraft fork: rfd and arboard have no Android backend. These two crates take their names:
+# elsewhere they re-export the real rfd and arboard, on Android they are answered by backends the
+# app installs (android/README.md).
+rfd = { package = "rfd-android-shim", path = "../../android/rfd-shim" }
